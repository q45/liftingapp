# Copy this file to .env and fill in real values.

# Postgres connection string.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
#
# Homebrew Postgres does NOT create a "postgres" role; it creates one named
# after your macOS user. Use whichever matches your setup:
#   Homebrew default : postgres://$USER@localhost:5432/lifting
#   Docker image     : postgres://postgres:postgres@localhost:5432/lifting
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lifting

# HTTP port the API listens on.
PORT=3000

# Comma-separated list of allowed CORS origins. Use "*" to allow any origin.
CORS_ORIGIN=*

# Optional shared secret the iOS client sends in X-API-Key. Leave blank to
# disable API-key auth entirely (useful in local dev).
API_KEY=

# Anthropic API key for the AI coach endpoint. Without this set, the
# /coach/recommendations route returns 503.
# Create at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model ID to use. Leave blank to accept the default (claude-sonnet-4-5).
# Override to claude-3-5-haiku-latest for cheaper/faster dev cycles.
ANTHROPIC_MODEL=

# How long cached coach recommendations stay valid, in seconds. Default 1h.
COACH_CACHE_TTL_SECONDS=3600

# How many recent completed workout sessions to include in the coach prompt.
COACH_RECENT_SESSIONS=6
